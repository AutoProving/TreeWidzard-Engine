#!/bin/bash
# Installed TreeWidzard launcher

set -euo pipefail

TREEWIDZARD_RUNTIME_DIR="@TREEWIDZARD_INSTALL_FULL_RUNTIME_DIR@"
TREEWIDZARD_BIN="$TREEWIDZARD_RUNTIME_DIR/treewidzard"
export TREEWIDZARD_DPCORES="@TREEWIDZARD_INSTALL_FULL_DPCORES_DIR@"
export TREEWIDZARD_SEARCHSTRATEGIES="@TREEWIDZARD_INSTALL_FULL_SEARCHSTRATEGIES_DIR@"

if [ ! -x "$TREEWIDZARD_BIN" ]; then
    echo "Error: installed treewidzard executable not found at $TREEWIDZARD_BIN" >&2
    exit 1
fi

exec "$TREEWIDZARD_BIN" "$@"
