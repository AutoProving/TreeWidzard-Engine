#!/bin/bash
# Installed TreeWidzard launcher

set -euo pipefail

TREEWIDZARD_RUNTIME_DIR="/Users/farhad.vadiee/Documents/github/system_paper/TreeWidzard-development/install-root-recheck/libexec/treewidzard"
TREEWIDZARD_BIN="$TREEWIDZARD_RUNTIME_DIR/treewidzard"
export TREEWIDZARD_DPCORES="/Users/farhad.vadiee/Documents/github/system_paper/TreeWidzard-development/install-root-recheck/libexec/treewidzard/DPCores"
export TREEWIDZARD_SEARCHSTRATEGIES="/Users/farhad.vadiee/Documents/github/system_paper/TreeWidzard-development/install-root-recheck/libexec/treewidzard/SearchStrategies"

if [ ! -x "$TREEWIDZARD_BIN" ]; then
    echo "Error: installed treewidzard executable not found at $TREEWIDZARD_BIN" >&2
    exit 1
fi

exec "$TREEWIDZARD_BIN" "$@"
